# Optional environment variables for the Remotion frontend (UI does not require them)
REMOTION_API_BASE=
REMOTION_BACKEND_URL=
REMOTION_FRONTEND_URL=
REMOTION_WS_URL=
REMOTION_NODE_ENV=development
REMOTION_NEXT_TELEMETRY_DISABLED=1
REMOTION_ENABLE_SOURCE_MAPS=true
REMOTION_PORT=3000
REMOTION_TRUST_PROXY=false
REMOTION_LOG_LEVEL=info
REMOTION_HEALTHCHECK_PATH=/health
REMOTION_FEATURE_FLAGS=
REMOTION_EXPERIMENTS_ENABLED=
